# Unity Catalog location for streaming checkpoints and benchmark results.

resource "databricks_schema" "pack" {
  catalog_name = var.uc_catalog
  name         = var.uc_schema
  comment      = "RTM Pattern Pack: checkpoints and benchmark results"
  properties = {
    project = "rtm-pattern-pack"
  }
}

resource "databricks_volume" "checkpoints" {
  catalog_name = var.uc_catalog
  schema_name  = databricks_schema.pack.name
  name         = "checkpoints"
  volume_type  = "MANAGED"
  comment      = "Structured Streaming checkpoints for RTM pattern jobs"
}

module "databricks_shared" {
  source = "../../modules/databricks_shared"

  kafka_bootstrap = module.msk.bootstrap_brokers_sasl_scram
  kafka_username  = module.msk.scram_username
  kafka_password  = module.msk.scram_password
}

# Reference data for the lookup pattern (05-lookup). The file is generated by
# `rtmpack refdata --pattern 05-lookup` and committed under patterns/05-lookup/data/.
resource "databricks_volume" "refdata" {
  catalog_name = var.uc_catalog
  schema_name  = databricks_schema.pack.name
  name         = "refdata"
  volume_type  = "MANAGED"
  comment      = "Static reference tables for RTM pattern jobs"
}

resource "databricks_file" "merchants" {
  source = "${local.patterns_root}/05-lookup/data/merchants.csv"
  path   = "/Volumes/${var.uc_catalog}/${databricks_schema.pack.name}/${databricks_volume.refdata.name}/merchants.csv"
}
